{
  "//": "Example, not installed. The harness never overwrites your editor settings; copy what you want into your own settings.json.",

  "//maxRequests": "Every stop at this ceiling waits for a person to click continue. A session of three to five sub-agents makes 100 to 200 requests, so 25 turned a quick fix into a series of stalls. The loops in loops/ and the burn-detect hook are what catch a runaway; this is the backstop, not the brake.",
  "chat.agent.maxRequests": 80,

  "//instructionFiles": "Turn off if you want the harness instructions ignored for a session, rather than deleting the junction.",
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  "//terminalAutoApprove": "Leave empty. The guardrails assume they see every command; an auto-approve list is how a destructive one gets past them.",
  "chat.tools.terminal.autoApprove": {}
}

{
  "//": "Example, not installed. The harness never overwrites your editor settings; copy what you want into your own settings.json.",

  "//credits": "Since June 2026 Copilot bills tokens, not requests: every model call resends the context, every tool result enters it, every sub-agent opens another context. See the credits of a turn by hovering the response, of the session in the context window control, of the month in the Copilot dashboard on the Status Bar; /chronicle:cost-tips suggests savings; Show Chat Debug View lists tokens and cache hits per request.",

  "//maxRequests": "Not a credit gate: each request bills its tokens whether or not a person clicked continue. A direct change finishes well under 25; a session of two to four sub-agents still makes 60 to 150 requests, so 80 keeps a session from stalling while loops/ and the burn-detect hook catch a runaway.",
  "chat.agent.maxRequests": 80,

  "//summarize": "The default, stated on purpose: compaction keeps a long session inside the window instead of failing it, and a summary is cheaper than the history it replaces.",
  "github.copilot.chat.summarizeAgentConversationHistory.enabled": true,

  "//instructionFiles": "Turn off if you want the harness instructions ignored for a session, rather than deleting the junction.",
  "github.copilot.chat.codeGeneration.useInstructionFiles": true,

  "//terminalAutoApprove": "Leave empty. The guardrails assume they see every command; an auto-approve list is how a destructive one gets past them. Approvals are clicks, not credits.",
  "chat.tools.terminal.autoApprove": {}
}

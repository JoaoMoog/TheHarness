{
  "$comment": "One dispatcher per tool event. No automatic formatting, staging or memory collection. Secrets and destructive-operation checks remain enabled.",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/session-context.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/loop-budget.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/tool-hooks.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/tool-hooks.mjs",
        "timeout": 20,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/telemetry.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/telemetry.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      },
      {
        "type": "command",
        "command": "node .github/hooks/scripts/contract-check.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/persist-session.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/audit-log.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ]
  }
}

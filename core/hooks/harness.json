{
  "$comment": "Runtime hooks in the format VS Code actually consumes. Paths are workspace-relative and resolve through the .github/hooks junction the harness installs. HARNESS_HOOK_MODE=vscode tells each script to read the event JSON from stdin instead of behaving as a git hook. The same scripts also run from .git/hooks/pre-commit, where they read the staged index instead. Every PreToolUse and PostToolUse entry runs on every tool call in VS Code, which ignores matchers, so the eight tool guardrails run inside one process per event, tool-hooks.mjs, in a fixed order, and each decides for itself whether the call concerns it.",
  "hooks": {
    "SessionStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/session-context.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "UserPromptSubmit": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/loop-budget.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "PreToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/tool-hooks.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "PostToolUse": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/tool-hooks.mjs",
        "timeout": 20,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "SubagentStart": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/telemetry.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "SubagentStop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/telemetry.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      },
      {
        "type": "command",
        "command": "node .github/hooks/scripts/contract-check.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "PreCompact": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/persist-session.mjs",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node .github/hooks/scripts/audit-log.mjs",
        "timeout": 3,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      },
      {
        "type": "command",
        "command": "node .github/hooks/scripts/dream-collect.mjs --hook",
        "timeout": 5,
        "env": {
          "HARNESS_HOOK_MODE": "vscode"
        }
      }
    ]
  }
}

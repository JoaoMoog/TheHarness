{
  "name": "the-harness",
  "version": "1.0.0",
  "description": "Portable agentic harness for GitHub Copilot and Kiro. One source of truth, propagated to any number of repositories without configuring each one.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "harness": "bin/harness.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "harness": "node bin/harness.mjs",
    "validate": "node bin/harness.mjs doctor --self",
    "eval": "node bin/harness.mjs eval",
    "budget": "node bin/harness.mjs budget",
    "selftest": "node core/hooks/scripts/selftest.mjs",
    "selftest:dream": "node core/hooks/scripts/dream-selftest.mjs",
    "selftest:spec": "node core/tools/spec/selftest.mjs",
    "test": "node --test tests/unit/*.test.mjs",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:full": "playwright test"
  },
  "keywords": [
    "github-copilot",
    "agentic",
    "skills",
    "agents",
    "context-engineering",
    "devops",
    "kiro"
  ],
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}

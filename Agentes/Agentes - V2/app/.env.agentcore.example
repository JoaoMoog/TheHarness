# Full environment reference: .env.runtime.example and ../docs/configuracao/README.md
# Add these server-only values to .env.pilot.local or your workload environment.
# Preserve the existing data source and authentication configuration.
STUDIO_AI_PROVIDER=agentcore
AI_PROVIDER=agentcore
AWS_REGION=us-east-1
AWS_PROFILE=clara-piloto
AGENTCORE_HARNESS_ARN=arn:aws:bedrock-agentcore:us-east-1:354918379749:harness/clara_pilot-gGzyXd2TUA
AGENTCORE_ENDPOINT=live
# Optional for a non-root caller permitted to assume the invoke-only role.
# AWS root cannot AssumeRole. The authorized local pilot uses its current login.
# AGENTCORE_INVOKER_ROLE_ARN=arn:aws:iam::354918379749:role/clara/clara-agentcore-invoker
# On an AWS workload use an attached IAM role and omit AWS_PROFILE.

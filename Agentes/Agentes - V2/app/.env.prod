# CLARA — prod. Preencha os identificadores do ambiente de destino.
# Não armazene credenciais aqui; use variáveis do processo ou Secrets Manager.
# Guia: ../docs/configuracao/01-AMBIENTE.md
PORT=3000
PUBLIC_APP_URL=https://clara-prod.example.com
CLARA_STORAGE_MODE=sqlite
PROMETEU_DATA_DIR=.data/prod
CLARA_TIME_ZONE=America/Sao_Paulo
AUTH_MODE=msal
LOCAL_AUTH_ENABLED=false
NEXT_TELEMETRY_DISABLED=1

# IAM role anexada à aplicação em produção. AWS_PROFILE apenas no computador local.
AWS_REGION=us-east-1
AWS_PROFILE=
AWS_SECRETS_REGION=us-east-1
CLARA_SECRET_ID=
CLARA_SECRETS_REQUIRED=true

# AD / Microsoft Entra: identificadores públicos, sem client secret (SPA + PKCE).
MSAL_TENANT_ID=
MSAL_API_CLIENT_ID=
MSAL_API_SCOPE=access_as_user
MSAL_SPA_CLIENT_ID=
MSAL_SPA_SCOPE=api://SEU_API_CLIENT_ID/access_as_user
CLARA_PLATFORM_ADMIN_GROUP_IDS=

# IA. O harness precisa usar o mesmo modelo; alterar apenas BEDROCK_MODEL_ID não muda o AgentCore.
STUDIO_AI_PROVIDER=agentcore
AI_PROVIDER=agentcore
BEDROCK_MODEL_ID=
BEDROCK_MAX_TOKENS=2000
BEDROCK_TIMEOUT_MS=60000
BEDROCK_TEMPERATURE=
BEDROCK_ADDITIONAL_FIELDS=
AGENTCORE_HARNESS_ARN=
AGENTCORE_ENDPOINT=live
AGENTCORE_INVOKER_ROLE_ARN=
# Parâmetros de provisionamento, não usados no navegador.
AGENTCORE_NAME=clara_prod
AGENTCORE_EXECUTION_ROLE_ARN=
BEDROCK_IMAGE_REGION=us-east-1
BEDROCK_IMAGE_MODEL_ID=

# Créditos: 250 chamadas/mês x 5 créditos.
CLARA_MONTHLY_CREDITS=1250
CLARA_AI_CREDIT_COST=5

# SAP Analytics Cloud — configure os valores do tenant; IDs de modelo não são nomes de stories.
STUDIO_DATA_PROVIDER=sap
SAP_CONNECTION_MODE=sac
SAP_SAC_TENANT_URL=
SAP_SAC_TOKEN_URL=
SAP_SAC_CLIENT_ID=
SAP_SAC_SCOPE=
SAP_SAC_NAMESPACE=sac
SAP_SAC_PROVIDER=
SAP_SAC_DEFAULT_QUERY=
# Sem curingas. Configure um conjunto de modelos para cada ID real de espaço CLARA.
SAP_SAC_WORKSPACE_MODELS='{}'
# Apenas para o dashboard financeiro legado, se a origem já tiver valores e datas compatíveis.
SAP_STUDIO_MAPPING=
# Conector OData/JSON legado: usado somente com SAP_CONNECTION_MODE=odata.
SAP_READ_URL=

# Piloto sintético local (npm run pilot); não consulta o SAP real.
FINANCIAL_TEST_PORT=4010
FINANCIAL_TEST_PROFILE=


# Utilitários operacionais (opcionais).
CLARA_SECRET_NAME=clara/prod/application
CLARA_SECRET_KMS_KEY_ID=

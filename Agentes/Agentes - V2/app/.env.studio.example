# Full environment reference: .env.runtime.example and ../docs/configuracao/README.md
# O iniciador npm run studio e o Compose já usam estes padrões.
# Não é necessário copiar este arquivo para experimentar a CLARA.
CLARA_STORAGE_MODE=memory
AUTH_MODE=demo
AI_PROVIDER=demo
STUDIO_DATA_PROVIDER=demo
STUDIO_AI_PROVIDER=demo
PUBLIC_APP_URL=http://localhost:3000

# Pendentes: ativar somente depois de configurar os serviços.
# STUDIO_DATA_PROVIDER=sap
# SAP_READ_URL=https://sap.exemplo/colecao-financeira
# SAP_READ_TOKEN=credencial-somente-no-servidor
# Campos são os nomes originais das propriedades JSON/OData, com correspondência exata.
# SAP_STUDIO_MAPPING={"id":"DocumentId","center":"CostCenter","company":"Company","date":"PostingDate","actual":"ActualAmount","budget":"BudgetAmount","currency":"Currency"}
# Em fonte comprovadamente BRL, substituir currency por "fixedCurrency":"BRL".

# STUDIO_AI_PROVIDER=bedrock
# AWS_REGION=regiao-do-modelo
# BEDROCK_MODEL_ID=modelo-ou-perfil-autorizado
# Credenciais pela cadeia padrão AWS (preferir identidade do workload).

# AUTH_MODE=msal
# LOCAL_AUTH_ENABLED=false
# MSAL_TENANT_ID=uuid-do-tenant
# MSAL_API_CLIENT_ID=uuid-do-registro-da-api
# MSAL_API_SCOPE=access_as_user
# MSAL_SPA_CLIENT_ID=uuid-do-registro-spa
# MSAL_SPA_SCOPE=api://uuid-do-registro-da-api/access_as_user
# PUBLIC_APP_URL=https://clara.sua-organizacao
# Registrar a mesma origem como retorno da SPA no provedor.

# Persistência definitiva é uma etapa de implementação e configuração posterior.
# Não habilitar múltiplas réplicas antes de compartilhar repositório e sessões.

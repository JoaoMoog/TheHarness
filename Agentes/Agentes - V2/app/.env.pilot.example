# Full environment reference: .env.runtime.example and ../docs/configuracao/README.md
# Copie para .env.pilot.local. Variáveis do terminal têm prioridade.
AWS_PROFILE=clara-piloto
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-5-5
STUDIO_AI_PROVIDER=bedrock
BEDROCK_IMAGE_REGION=us-west-2
BEDROCK_IMAGE_MODEL_ID=stability.stable-image-core-v1:1
AUTH_MODE=msal
LOCAL_AUTH_ENABLED=false
# Aplicativo SPA de tenant único, sem segredo. Veja docs/CLARA-SSO-MICROSOFT.md.
MSAL_TENANT_ID=
MSAL_SPA_CLIENT_ID=
MSAL_API_CLIENT_ID=
MSAL_API_SCOPE=access_as_user
MSAL_SPA_SCOPE=
# PORT=3000
# FINANCIAL_TEST_PORT=4010
# FINANCIAL_TEST_PROFILE=normal
# Credenciais na cadeia padrão AWS. Nunca em NEXT_PUBLIC_*.
# O token HTTP do serviço sintético é gerado por execução se não definido.

# Demo defaults. Do not put secrets in NEXT_PUBLIC_* variables.
AUTH_MODE=demo
AI_PROVIDER=demo

# TypeSafe / Jev: server-only API key. Fill the value in .env.local.
# Verify with npm run jev:check. This enables the SDK, not the dashboard chat provider.
TYPESAFE_API_KEY=
TYPESAFE_DEFAULT_MODEL=jev-latest
# Local accounts have separate data and password authentication. Set false to disable.
LOCAL_AUTH_ENABLED=true
# PUBLIC_APP_URL=https://your-prometeu-host.example
# PROMETEU_DATA_DIR=/absolute/writable/path

# Microsoft: expose an API scope and allow access in the selected tenant.
# AUTH_MODE=msal
# MSAL_TENANT_ID=tenant-uuid
# MSAL_API_CLIENT_ID=api-registration-client-uuid
# MSAL_API_SCOPE=access_as_user
# NEXT_PUBLIC_MSAL_CLIENT_ID=spa-registration-client-uuid
# NEXT_PUBLIC_MSAL_TENANT_ID=tenant-uuid
# NEXT_PUBLIC_MSAL_SCOPE=api://api-registration-client-uuid/access_as_user
# Configure the SPA redirect URI to match the app's origin. Rebuild after changing NEXT_PUBLIC_*.

# AWS uses the default credential chain on the server (role/profile/secure variables).
# AI_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=your-enabled-model-or-inference-profile

# Optional read-only SAP collection: JSON array or OData value / d.results.
# Server-only settings; never use NEXT_PUBLIC_ for the token.
# SAP_READ_URL=https://your-sap-gateway.example/authorized-collection
# SAP_READ_TOKEN=server-only-bearer-token

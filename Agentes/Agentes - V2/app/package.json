{
  "name": "prometeu",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "test:e2e": "node tests/run-e2e.mjs",
    "studio": "node scripts/studio.mjs",
    "studio:start": "node scripts/studio.mjs --production",
    "contracts:studio": "tsx scripts/export-studio-contract.ts",
    "pilot": "node scripts/pilot.mjs",
    "pilot:start": "node scripts/pilot.mjs --production",
    "bedrock:check": "node --import tsx scripts/check-bedrock.ts",
    "banner:check": "node --import tsx scripts/check-banner.ts",
    "test:pilot": "node --import tsx --test tests/pilot*.test.ts",
    "test:pilot:e2e": "node tests/run-e2e.mjs pilot.spec.ts",
    "test:bedrock:live": "node --import tsx scripts/test-bedrock-live.ts",
    "agentcore:check": "node --import tsx scripts/check-agentcore.ts",
    "test:agentcore:live": "node --import tsx scripts/test-agentcore-live.ts",
    "secrets:migrate": "node --import tsx scripts/secrets-migrate.ts",
    "agentcore:model": "node --import tsx scripts/configure-agentcore-model.ts"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-agentcore": "^3.1152.0",
    "@aws-sdk/client-bedrock-runtime": "^3.900.0",
    "@aws-sdk/client-secrets-manager": "^3.1152.0",
    "@aws-sdk/client-sts": "^3.1152.0",
    "@aws-sdk/credential-providers": "^3.1152.0",
    "@azure/msal-browser": "^4.0.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/figtree": "^5.3.0",
    "@radix-ui/react-select": "^2.3.8",
    "@tailwindcss/postcss": "^4.1.0",
    "jose": "^6.0.0",
    "lucide-react": "^0.468.0",
    "next": "^16.0.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "^3.0.0",
    "tailwindcss": "^4.1.0",
    "xlsx": "^0.18.5",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@aws-sdk/client-bedrock": "^3.1152.0",
    "@aws-sdk/client-bedrock-agentcore-control": "^3.1152.0",
    "@aws-sdk/client-iam": "^3.1152.0",
    "@axe-core/playwright": "^4.10.0",
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}

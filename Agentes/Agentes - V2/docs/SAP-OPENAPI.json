{
  "openapi": "3.1.0",
  "info": {
    "title": "CLARA — SAP Analytics Cloud Data Export",
    "version": "1.0.0",
    "description": "Contrato do adaptador de leitura. Espelha o subconjunto documentado do Data Export Service; não é um serviço SAP oficial. OAuth técnico permanece no servidor. Sem escrita, $batch ou sincronização delta."
  },
  "servers": [
    {
      "url": "/api/v1/sap/dataexport"
    }
  ],
  "paths": {
    "/administration/$metadata": {
      "get": {
        "summary": "Metadados do catálogo",
        "security": [
          {
            "session": []
          }
        ],
        "parameters": [
          {
            "name": "x-clara-workspace",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            },
            "description": "ID do espaço CLARA ao qual a sessão deve pertencer."
          },
          {
            "name": "$select",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Projeção OData; preserve as dimensões exigidas pelo modelo SAC."
          },
          {
            "name": "$filter",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Expressão OData interpretada pelo SAP."
          },
          {
            "name": "$top",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000
            }
          },
          {
            "name": "$skip",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 0,
              "maximum": 20000
            }
          },
          {
            "name": "$skiptoken",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Cursor devolvido pelo SAP; não invente valores."
          },
          {
            "name": "nextEntity",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 2048
            },
            "description": "Cursor devolvido pelo SAP; não invente valores."
          },
          {
            "name": "$format",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "json"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Resposta SAC; catálogo limitado aos modelos autorizados e nextLink reescrito para a CLARA.",
            "content": {
              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          },
          "401": {
            "description": "Sem sessão",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Sem acesso ao espaço/modelo",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Endpoint não disponível",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Resposta excessiva",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "422": {
            "description": "Parâmetro inválido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "502": {
            "description": "Falha SAP/contrato",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Configuração pendente",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Tempo excedido",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },

{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "SpeedCode — API exemplo .NET 10",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build-api-example",
      "program": "${workspaceFolder}/examples/dotnet-run/bin/Debug/net10.0/Api.dll",
      "cwd": "${workspaceFolder}/examples/dotnet-run",
      "env": {
        "ASPNETCORE_URLS": "http://127.0.0.1:51879",
        "ASPNETCORE_ENVIRONMENT": "Development"
      },
      "serverReadyAction": {
        "action": "openExternally",
        "pattern": "\\bNow listening on:\\s+(https?://\\S+)",
        "uriFormat": "%s/swagger"
      }
    }
  ]
}
